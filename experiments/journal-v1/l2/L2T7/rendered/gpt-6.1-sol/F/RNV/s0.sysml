            perform action a6 { doc /* reserve compute capacity for validated recovery runs from known-good inputs @S220 */ }
        }
        part processingLevel : ProcessingLevel {
            perform action a0 { doc /* records software build identifiers, calibration baseline identifiers, and ancillary input versions @S158 */ }
        }
