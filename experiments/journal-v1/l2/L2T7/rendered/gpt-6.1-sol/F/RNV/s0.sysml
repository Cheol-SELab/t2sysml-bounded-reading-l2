            perform action a1 { doc /* connect to the Mission Control Center through protected access routers @S054 */ }
        }
        part spacecraft : Spacecraft;
        part spacecraftOperationsTeam : SpacecraftOperationsTeam {
            perform action a0 { doc /* monitors spacecraft mode, power state, thermal margins, attitude indicators, command counters, onboard storage, and fault protection messages from the Mission Control Center consoles @S082 */ }
            perform action a1 { doc /* coordinate closely before orbit-control activities @S097 */ }
            perform action a2 { doc /* reviews late operational requests when they affect spacecraft attitude, thermal margin, stored command capacity, or contact preparation @S105 */ }
            perform action a3 { doc /* uses the Antenna Deicing Notice @S113 */ }
            perform action a4 { doc /* assess whether planned support can proceed without adding contingency contact margin @S113 */ }
            perform action a5 { doc /* receives a maneuver recommendation package that includes timing constraints and operational impacts @S137 */ }
            perform action a6 { doc /* receives maneuver recommendations with enough lead time @S146 */ }
            perform action a7 { doc /* rehearse commanding @S146 */ }
            perform action a8 { doc /* verify contingency actions @S146 */ }
            perform action a9 { doc /* coordinate contact coverage @S146 */ }
            perform action a10 { doc /* uses the Pass Replay Packet @S198 */ }
            perform action a11 { doc /* confirm that archived downlink context can support anomaly reconstruction @S198 */ }
            perform action a12 { doc /* leads triage for spacecraft safety indicators @S209 */ }
            perform action a13 { doc /* conducts at least one integrated day-in-the-life rehearsal that includes pass preparation, commanding discipline, telemetry surveillance, anomaly declaration, and recovery reporting @S235 */ }
        }
        part spacecraftSystemsEngineer : SpacecraftSystemsEngineer {
            perform action a0 { doc /* interprets health telemetry @S086 */ }
