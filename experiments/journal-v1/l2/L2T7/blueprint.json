{
 "title": "Operational Concept for the Sentinel Vale Earth-Observation Ground Segment",
 "sections": [
  {
   "index": 1,
   "heading": "Mission Context and Ground Segment Boundaries",
   "topic": "Defines the Sentinel Vale mission objectives, the operational scope of the ground segment, the main facilities, and the shared assumptions for service hours, autonomy, and mission assurance."
  },
  {
   "index": 2,
   "heading": "Ground Station Estate and Contact Allocation",
   "topic": "Describes the S-band and X-band antenna resources, contact booking rules, local station responsibilities, weather constraints, and ground network management practices."
  },
  {
   "index": 3,
   "heading": "Wide Area Connectivity and Timing Services",
   "topic": "Explains the network topology, routing controls, latency budgets, time synchronization approach, and cybersecurity monitoring applied across all operational sites."
  },
  {
   "index": 4,
   "heading": "Telemetry Reception and Mission Control Operations",
   "topic": "Covers telemetry ingest, spacecraft state monitoring, pass reconstruction, console roles, escalation routines, and the relationship between mission control and subsystem specialists."
  },
  {
   "index": 5,
   "heading": "Mission Planning and Command Preparation",
   "topic": "Details observation request intake, schedule generation, command stack validation, constraints checking, and approval gates before uplink opportunities."
  },
  {
   "index": 6,
   "heading": "Flight Dynamics Products and Orbit Maintenance",
   "topic": "Describes orbit determination, maneuver screening, attitude geometry support, collision assessment inputs, and delivery of flight dynamics products to operations users."
  },
  {
   "index": 7,
   "heading": "Payload Processing and Product Quality Control",
   "topic": "Defines raw data transfer, image processing levels, calibration handling, quality flags, product holds, and fallback behavior between processing clusters."
  },
  {
   "index": 8,
   "heading": "Archive, Catalogue, and User Dissemination",
   "topic": "Explains long-term storage, catalogue publication, user download services, retention policies, data reprocessing triggers, and external service interfaces."
  },
  {
   "index": 9,
   "heading": "Security, Resilience, and Anomaly Response",
   "topic": "Sets out operational security controls, anomaly triage, continuity modes, cross-site failover, evidence preservation, and recovery criteria after degraded operations."
  },
  {
   "index": 10,
   "heading": "Readiness Reviews, Exercises, and Operational Metrics",
   "topic": "Specifies rehearsals, acceptance evidence, operational key performance indicators, configuration baselines, and handover conditions for routine mission service."
  }
 ],
