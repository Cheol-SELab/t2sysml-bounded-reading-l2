{
 "title": "Operational Concept for the Cedar Falls Municipal Drinking Water Treatment Plant Control System",
 "sections": [
  {
   "index": 1,
   "heading": "Plant Mission, Boundaries, and Control Architecture",
   "topic": "Defines the treatment plant mission, control-system scope, operating assumptions, major interfaces, and the roles of the intake, treatment, laboratory, and distribution functions."
  },
  {
   "index": 2,
   "heading": "River Intake and Raw Water Screening Operations",
   "topic": "Describes river intake operating modes, screen-channel monitoring, raw-water quality triggers, pump permissives, and storm-response coordination."
  },
  {
   "index": 3,
   "heading": "Coagulation, Chemical Dosing, and Filter Control",
   "topic": "Explains coagulant adjustment, filter run management, analyzer feedback, manual override expectations, and how operators respond to process deviations."
  },
  {
   "index": 4,
   "heading": "Laboratory Sampling, Verification, and Data Acceptance",
   "topic": "Covers sample custody, laboratory verification steps, field-to-lab data reconciliation, and quality rules for accepting process measurements."
  },
  {
   "index": 5,
   "heading": "Maintenance Coordination, Chemical Access, and Work Control",
   "topic": "Outlines planned work controls, supplier access, lockout coordination, shift communication, and evidence required before equipment is returned to service."
  },
  {
   "index": 6,
   "heading": "Disinfection, Clearwell Control, and High-Service Pumping",
   "topic": "Details chlorine contact management, clearwell operating limits, pump-header sequencing, pressure support, and abnormal-condition safeguards."
  },
  {
   "index": 7,
   "heading": "Backwash Recovery, Residuals Handling, and Process Upset Response",
   "topic": "Describes backwash recovery, solids handling, exception review, upset classification, and operator actions during storm-driven or filtration-related events."
  },
  {
   "index": 8,
   "heading": "Distribution Monitoring and Dispatch Coordination",
   "topic": "Explains pressure-zone monitoring, dispatcher responsibilities, handoff practices, distribution station behavior, and control-room coordination with field crews."
  },
  {
   "index": 9,
   "heading": "Cybersecurity, Reliability, Alarms, and Emergency Governance",
   "topic": "Defines access controls, alarm governance, backup power expectations, emergency authority, cybersecurity controls, and reliability requirements for critical plant services."
  },
  {
   "index": 10,
   "heading": "Commissioning, Training, Performance Review, and Continuous Improvement",
   "topic": "Sets expectations for commissioning tests, operator training, maintenance feedback, distribution readiness, records retention, and periodic improvement of the control concept."
  }
 ],
