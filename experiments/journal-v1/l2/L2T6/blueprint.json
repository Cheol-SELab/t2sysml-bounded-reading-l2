{
 "title": "Airport Checked-Baggage Handling and Screening Operational Concept",
 "sections": [
  {
   "index": 1,
   "heading": "System Purpose and Operating Boundaries",
   "topic": "Define the end-to-end operating concept, system boundaries, principal interfaces, service objectives, and coordination responsibilities."
  },
  {
   "index": 2,
   "heading": "Bag Acceptance and Induction",
   "topic": "Describe check-in acceptance, bag identification, oversize handling, transfer-feed entry, and controlled induction onto the conveyor network."
  },
  {
   "index": 3,
   "heading": "Screening and Alarm Response",
   "topic": "Explain screening stages, image review, alarm handling, access controls, and the safe routing of bags requiring additional examination."
  },
  {
   "index": 4,
   "heading": "Sortation and Routing Control",
   "topic": "Set out sort-plan execution, route selection, congestion awareness, exception diversion, and recovery of bags from abnormal paths."
  },
  {
   "index": 5,
   "heading": "Flight Data and Cutoff Management",
   "topic": "Describe how flight information, planned dispatch times, operational cutoffs, and screening status govern routing and prioritization."
  },
  {
   "index": 6,
   "heading": "Make-Up and Transfer Operations",
   "topic": "Define bag delivery to make-up positions, transfer-bag handling, release authorization, and coordination with airline ground operations."
  },
  {
   "index": 7,
   "heading": "Manual Resolution and Reconciliation",
   "topic": "Explain operator image resolution, identity checks, bag-to-flight reconciliation, and controlled return to the planned process."
  },
  {
   "index": 8,
   "heading": "Safety, Maintenance, and Recovery",
   "topic": "Specify safe operating states, maintenance access, fault response, conveyor recovery, and the responsibilities of technical and supervisory personnel."
  },
  {
   "index": 9,
   "heading": "Security, Custody, and Departure Readiness",
   "topic": "Describe secure handling, custody assurance, final reconciliation, and the checks required before bags are accepted for aircraft loading."
  },
  {
   "index": 10,
   "heading": "Performance Assurance and Contingency Operations",
   "topic": "Set out operational monitoring, service measures, degraded-mode decisions, escalation, and return-to-service criteria."
  }
 ],
