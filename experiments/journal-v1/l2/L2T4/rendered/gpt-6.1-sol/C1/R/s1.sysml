    requirement def R0 { doc /* Its approved setting group defines the pickup levels, time delays, and logic required for the feeder protection scheme. @S053 */ subject s : FeederProtectionScheme; }
    requirement def R1 { doc /* A controlled outage or other approved work window is required when implementation could affect feeder protection. @S068 */ subject s : Implementation; }
    requirement def R2 { doc /* Field access begins only after the required work authorization and site entry controls are confirmed. @S076 */ subject s : FieldAccess; }
    requirement def R3 { doc /* Required checks of position, isolation, and absence of hazardous energy are performed using approved site procedures. @S086 */ subject s : RequiredChecksOfPositionIsolationAndAbsenceOfHazardousEnergy; }
