{
 "title": "Operational Concept for the Alder Creek Electrical Distribution Substation Automation System",
 "sections": [
  {
   "index": 1,
   "heading": "Substation Mission and Automation Boundary",
   "topic": "Establish the station operating boundary, introduce the Bay Automation Controller with the project codename Juniper, and describe the initial protection and bay-control responsibilities."
  },
  {
   "index": 2,
   "heading": "Supervisory Architecture and Time Services",
   "topic": "Introduce the Station Supervisory Control System as Glasswing and the Satellite Time Receiver as Bluefin while explaining supervisory visibility, time distribution, and their operating limits."
  },
  {
   "index": 3,
   "heading": "Protection and Engineering Configuration",
   "topic": "Introduce the Feeder Protection Relay as Tandem and the Protection Relay Engineer as Larkspur, then establish the engineering, review, and controlled configuration practices."
  },
  {
   "index": 4,
   "heading": "Field Work and Safe Access",
   "topic": "Introduce the Substation Field Crew as Cinder and explain how field access, work control, and confirmation of equipment conditions fit into automated operations."
  },
  {
   "index": 5,
   "heading": "Event Evidence and Operational Records",
   "topic": "Introduce the Sequence Event Archive as Orchard and define how the station preserves event evidence, supports engineering review, and maintains records for later use."
  },
  {
   "index": 6,
   "heading": "Switching Coordination and Bay Boundaries",
   "topic": "Introduce the Switching Desk Coordinator as Keystone, explain switching coordination, and distinguish the North Bay Controller from the South Bay Controller."
  },
  {
   "index": 7,
   "heading": "Alarms, Operator Response, and Protection Panels",
   "topic": "Set out the control-room operator’s alarm response and distinguish the North Protection Panel from the Transformer Protection Panel in operational procedures."
  },
  {
   "index": 8,
   "heading": "Communications, Control, and Equipment Feedback",
   "topic": "Describe the exchange of control and equipment feedback across station interfaces, including the responsibilities of the gateway, controller, and protection functions."
  },
  {
   "index": 9,
   "heading": "Maintenance, Testing, and Degraded Operation",
   "topic": "Explain maintenance coordination, controlled testing, and the handling of degraded communications or equipment conditions without weakening field safety controls."
  },
  {
   "index": 10,
   "heading": "Operating Assurance and Handover",
   "topic": "Close with operational assurance, switching handover, responsibility boundaries, and the review practices that keep automation actions traceable and safe."
  }
 ],
