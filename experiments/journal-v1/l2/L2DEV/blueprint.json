{
 "title": "Regional Emergency Medical Dispatch and Ambulance Coordination Operational Concept",
 "sections": [
  {
   "index": 1,
   "heading": "Mission, Authority, and Operating Model",
   "topic": "Defines the regional service mandate, decision authority, and coordination roles, including the Regional Dispatch Center (Juniper) and Shift Commander (Sundial)."
  },
  {
   "index": 2,
   "heading": "Coverage Geography and Readiness",
   "topic": "Explains service zones, access conditions, readiness checks, the Radio Coordinator (Mistral), the Fleet Maintenance Cell (Bluejay), and the two gate status boards."
  },
  {
   "index": 3,
   "heading": "Call Intake and Incident Creation",
   "topic": "Describes how Call Taker Mara (Larkspur) gathers location and medical details and how the Hospital Liaison Desk (Kestrel) supports intake coordination."
  },
  {
   "index": 4,
   "heading": "Clinical Triage and Dispatch Priorities",
   "topic": "Sets out clinical prioritization, escalation rules, and the responsibilities of the Triage Supervisor (Copperfield) and Data Quality Officer (Pebble)."
  },
  {
   "index": 5,
   "heading": "Resource Selection and Dispatch",
   "topic": "Covers ambulance selection, dispatch authorization, radio procedures, and the controlled handoff from the dispatch floor to field crews."
  },
  {
   "index": 6,
   "heading": "Field Operations and Unit Movement",
   "topic": "Explains staging, route changes, crew status updates, and the use of readiness information to maintain safe ambulance coverage."
  },
  {
   "index": 7,
   "heading": "Hospital Coordination and Patient Arrival",
   "topic": "Describes destination consultation, receiving-facility coordination, and the confirmation of patient arrival and handover."
  },
  {
   "index": 8,
   "heading": "Surge, Mutual Aid, and Clinical Exceptions",
   "topic": "Defines surge triggers, mutual-aid coordination, pediatric escalation, and exception handling across dispatch and receiving facilities."
  },
  {
   "index": 9,
   "heading": "Communications Resilience and Shift Control",
   "topic": "Sets out degraded-radio procedures, coverage monitoring, shift-level decisions, and continuity of command during disruptions."
  },
  {
   "index": 10,
   "heading": "Assurance, Review, and Improvement",
   "topic": "Establishes audit, release, maintenance, and performance-review practices that support safe and accountable regional operations."
  }
 ],
