    requirement def R3 { doc /* Personnel must not hold the barrier open for another entrant. @S847 */ subject s : Personnel; }
    requirement def R4 { doc /* Lighting inside the car and at each landing must be adequate for safe movement and inspection. @S891 */ subject s : WestServiceLift; }
    requirement def R5 { doc /* Door interlocks and other protective devices must be functional before the lift is placed in service. @S893 */ subject s : WestServiceLift; }
    requirement def R6 { doc /* Protective devices must not be bypassed to maintain access or avoid delay. @S894 */ subject s : WestServiceLift; }
