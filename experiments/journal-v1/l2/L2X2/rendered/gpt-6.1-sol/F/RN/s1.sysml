            perform action a28 { doc /* escalates any condition that threatens equipment limits, protection coordination, or safe operation @S560 */ }
            perform action a29 { doc /* confirms authorization and restores output gradually while monitoring equipment response @S562 */ }
            perform action a30 { doc /* confirms that proposed changes have a clear operational purpose and defined scope @S594 */ }
            perform action a31 { doc /* supports remote shutdown actions when communications and equipment status allow safe intervention @S630 */ }
            perform action a32 { doc /* provides technical guidance when recovery handling could affect turbine systems or restart readiness @S658 */ }
            perform action a33 { doc /* checks that remote indications agree with the approved switching state @S718 */ }
            perform action a34 { doc /* authorizing access @S718 */ }
            perform action a35 { doc /* verifies the restoration state and communicates any remaining operational limitation to affected personnel @S734 */ }
