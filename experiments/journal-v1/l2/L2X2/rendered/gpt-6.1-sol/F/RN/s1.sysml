            perform action a37 { doc /* reviews alarms and operating trends with the SCADA Engineer when an abnormal condition may require intervention @S768 */ }
            perform action a38 { doc /* verifies the equipment state and checks that protection actions have completed @S799 */ }
            perform action a39 { doc /* authorizing any further operational action @S799 */ }
            perform action a40 { doc /* examines significant operational deviations and records the technical findings for review @S920 */ }
            perform action a41 { doc /* suspends those commands and uses approved local procedures until reliable control is restored @S938 */ }
            perform action a42 { doc /* coordinates technical recovery with the relevant field and shore roles @S951 */ }
            perform action a43 { doc /* reviews control-room practices and confirms that operational procedures remain consistent with the concept @S964 */ }
