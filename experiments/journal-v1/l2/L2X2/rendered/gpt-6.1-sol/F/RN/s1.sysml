            perform action a13 { doc /* reviews the restored equipment state and confirms that required operational checks are complete @S338 */ }
            perform action a14 { doc /* investigates unexplained discrepancies @S349 */ }
            perform action a15 { doc /* reviews each instruction for consistency with current plant status @S368 */ }
            perform action a16 { doc /* applying it @S368 */ }
            perform action a17 { doc /* confirms that the control response follows the instruction and remains within the permitted ramp rate @S375 */ }
            perform action a18 { doc /* records the reason for any temporary deviation from the requested output and the action taken @S384 */ }
            perform action a19 { doc /* use individually assigned accounts rather than shared credentials for interactive work @S423 */ }
            perform action a20 { doc /* coordinate any operational changes with the relevant duty role before implementation @S434 */ }
            perform action a21 { doc /* checks the current network configuration and confirms that the proposed sequence supports the approved work @S516 */ }
            perform action a22 { doc /* prepares clear switching instructions with one action per step and an explicit hold point where needed @S528 */ }
            perform action a23 { doc /* monitors available indications and confirms that each reported state change matches the approved sequence @S534 */ }
            perform action a24 { doc /* verifies the permitted level, its effective time, and any required ramp rate @S542 */ }
            perform action a25 { doc /* changing operating targets @S542 */ }
            perform action a26 { doc /* reduces active power in controlled steps and checks that measured export follows the revised target @S544 */ }
