{
 "title": "Offshore Wind Farm Operations and Maintenance System Operational Concept",
 "sections": [
  {
   "index": 1,
   "heading": "Purpose and Operational Scope",
   "topic": "Defines the farm boundary, operational objectives, lifecycle assumptions, and interfaces covered by the concept."
  },
  {
   "index": 2,
   "heading": "Operating Context and Naming",
   "topic": "Introduces the Turbine Controller as Glassfin, the Offshore Substation as Morrowick, and the Weather Service as Pale Lantern while establishing the operating context."
  },
  {
   "index": 3,
   "heading": "System Architecture",
   "topic": "Introduces the SCADA Gateway as Juniper Vale, the Maintenance Planning Engine as Thistle Crown, and the Shore Control Room as Amber Quay within the system architecture."
  },
  {
   "index": 4,
   "heading": "People, Fleet, and Logistics",
   "topic": "Introduces the Crew Transfer Vessel as Kestrel Bay, Fleet Dispatch Console as Sable Orchard, and Warehouse System as Mosslight while describing the operational organization."
  },
  {
   "index": 5,
   "heading": "Offshore Sensing and Cyber Boundaries",
   "topic": "Introduces the Metocean Buoy as Copper Finch and Cybersecurity Gateway as Quiet Harbor while outlining environmental sensing and security boundaries."
  },
  {
   "index": 6,
   "heading": "Turbine Control and Field Observation",
   "topic": "Introduces the Vessel AIS Receiver as Blue Granite and Blade Inspection Drone as Larkspur, and describes turbine control and remote observation."
  },
  {
   "index": 7,
   "heading": "Work Authorization",
   "topic": "Introduces the Work Permit Portal as Redoubt and establishes the work authorization lifecycle."
  },
  {
   "index": 8,
   "heading": "Electrical Supply and Backup",
   "topic": "Introduces the Emergency Generator as Foxglove and describes normal and standby electrical supply."
  },
  {
   "index": 9,
   "heading": "Grid Interface",
   "topic": "Introduces the Grid Interface Relay as Wildmere and explains the farm’s grid connection and dispatch boundary."
  },
  {
   "index": 10,
   "heading": "Marine Coordination",
   "topic": "Explains marine coordination across vessel movements, personnel transfers, and shore-side support."
  },
  {
   "index": 11,
   "heading": "Maintenance Planning",
   "topic": "Describes how planned and corrective work is prioritized against asset condition, access, and resource availability."
  },
  {
   "index": 12,
   "heading": "Weather-Led Decisions",
   "topic": "Sets out how forecast confidence, operational limits, and changing conditions shape work and vessel decisions."
  },
  {
   "index": 13,
   "heading": "Turbine Condition Monitoring",
   "topic": "Explains how turbine observations are reviewed, validated, and escalated into operational responses."
  },
  {
   "index": 14,
   "heading": "Permit and Isolation Controls",
   "topic": "Describes the relationship between work authorization, electrical isolation, field execution, and return to service."
  },
  {
   "index": 15,
   "heading": "Substation Operations",
   "topic": "Covers safe substation operation, routine checks, backup readiness, and operator responsibilities."
  },
  {
   "index": 16,
   "heading": "Grid Dispatch and Export",
   "topic": "Explains export coordination, grid instructions, and the management of operational constraints."
  },
  {
   "index": 17,
   "heading": "Crew Accountability",
   "topic": "Establishes how personnel movements and accountability are managed across shore and offshore locations."
  },
  {
   "index": 18,
   "heading": "Cybersecurity Operations",
   "topic": "Defines security monitoring, incident handling, access governance, and the operational responsibilities of technical teams."
  },
  {
   "index": 19,
   "heading": "Blade Inspection and Repair",
   "topic": "Covers remote and close-access blade inspection, defect assessment, and repair planning."
  },
  {
   "index": 20,
   "heading": "Port and Berth Coordination",
   "topic": "Describes port coordination and the handling of berth capacity alongside offshore task readiness."
  },
  {
   "index": 21,
   "heading": "Access and Worksite Safety",
   "topic": "Explains access control, worksite boundaries, and field safety checks before maintenance begins."
  },
  {
   "index": 22,
   "heading": "Switching Coordination",
   "topic": "Sets out the coordination needed to schedule, approve, and confirm operational switching."
  },
  {
   "index": 23,
   "heading": "Export Constraint Response",
   "topic": "Describes how operational teams respond to limits on energy export while preserving equipment protection."
  },
  {
   "index": 24,
   "heading": "Marine Personnel Reconciliation",
   "topic": "Defines the reconciliation of personnel counts and the escalation of discrepancies during marine operations."
  },
  {
   "index": 25,
   "heading": "Software and Configuration Assurance",
   "topic": "Covers software integrity, configuration control, and technical approval before changes reach operational systems."
  },
  {
   "index": 26,
   "heading": "Emergency and Recovery Readiness",
   "topic": "Establishes emergency roles, rescue readiness, and the practical limits of offshore recovery operations."
  },
  {
   "index": 27,
   "heading": "Vessel Recovery Support",
   "topic": "Describes coordination of recovery resources and safe handling of equipment during offshore response."
  },
  {
   "index": 28,
   "heading": "Visibility and Operational Confidence",
   "topic": "Explains how uncertainty in visibility assessments affects task selection, vessel movements, and go or no-go decisions."
  },
  {
   "index": 29,
   "heading": "Inventory and Spare Parts",
   "topic": "Describes stock visibility, replenishment priorities, and the handling of supply exceptions."
  },
  {
   "index": 30,
   "heading": "Isolation Boundary Management",
   "topic": "Explains how approved isolation boundaries are communicated, checked, and maintained during field work."
  },
  {
   "index": 31,
   "heading": "Substation Switching Windows",
   "topic": "Covers the alignment of substation availability with agreed switching and maintenance windows."
  },
  {
   "index": 32,
   "heading": "Communications and Operating Records",
   "topic": "Defines operational communications, record quality, and the retention of evidence needed for safe decisions."
  },
  {
   "index": 33,
   "heading": "Asset Protection and Fire Response",
   "topic": "Describes fire detection, equipment protection, alarm response, and coordination with offshore personnel."
  },
  {
   "index": 34,
   "heading": "North Access Control",
   "topic": "Explains how the North Access Scanner validates controlled entry and supports traceable access decisions."
  },
  {
   "index": 35,
   "heading": "South Access Control",
   "topic": "Explains how the South Access Scanner supports its distinct access route without weakening common security controls."
  },
  {
   "index": 36,
   "heading": "Vertical Movement: East Route",
   "topic": "Describes how the East Service Lift is inspected and released for personnel and equipment movement."
  },
  {
   "index": 37,
   "heading": "Vertical Movement: West Route",
   "topic": "Describes how the West Service Lift is operated under route-specific checks and common safety requirements."
  },
  {
   "index": 38,
   "heading": "Performance and Reliability",
   "topic": "Defines operational performance measures, reliability review, and the use of lessons learned to improve the system."
  },
  {
   "index": 39,
   "heading": "Degraded Modes and Recovery",
   "topic": "Explains degraded operating modes, prioritization of essential functions, and controlled recovery to normal service."
  },
  {
   "index": 40,
   "heading": "Governance and Operational Assurance",
   "topic": "Summarizes governance, assurance evidence, review responsibilities, and the controlled evolution of the operating concept."
  }
 ],
