{
 "title": "Operational Concept for the Caldera Wildfire Detection and Suppression Support System",
 "sections": [
  {
   "index": 1,
   "heading": "Mission Context and Operational Scope",
   "topic": "Defines the wildfire threat environment, participating agencies, supported decisions, and the boundaries between detection support, suppression support, and command authority."
  },
  {
   "index": 2,
   "heading": "System Architecture and Site Layout",
   "topic": "Describes the fixed camera masts, drone dock, analytics services, communications links, weather ingestion, and primary operator interfaces used across the operating area."
  },
  {
   "index": 3,
   "heading": "Detection, Triage, and Confirmation Workflow",
   "topic": "Explains how smoke indications, thermal cues, human review, and confirmation rules move a suspected ignition from first observation to an actionable incident record."
  },
  {
   "index": 4,
   "heading": "Airspace, Radio, and Interagency Coordination",
   "topic": "Covers flight deconfliction, radio bridging, county liaison procedures, temporary restrictions, and coordination with crew and aviation supervisors."
  },
  {
   "index": 5,
   "heading": "Fire Behavior Assessment and Common Operating Picture",
   "topic": "Details how camera observations, drone imagery, weather updates, and geospatial overlays are converted into map products and operational recommendations."
  },
  {
   "index": 6,
   "heading": "Suppression Planning and Aviation Support",
   "topic": "Describes how drone reconnaissance, tanker dispatch planning, retardant loading status, and supervisor approvals support initial attack and extended attack."
  },
  {
   "index": 7,
   "heading": "Ground Crew Integration and Resource Staging",
   "topic": "Explains how helitack and ground crews receive assignments, staging information, hazards, and updated intelligence from the support system."
  },
  {
   "index": 8,
   "heading": "Reliability, Cybersecurity, and Maintenance Operations",
   "topic": "Specifies degraded-mode behavior, authentication, audit logging, data retention, equipment maintenance, and resilience expectations during long incidents."
  },
  {
   "index": 9,
   "heading": "Training, Exercises, and Performance Measures",
   "topic": "Defines role-based training, tabletop and live exercises, evaluation metrics, false-alarm review, and proficiency requirements for seasonal readiness."
  },
  {
   "index": 10,
   "heading": "Deployment Governance and Continuous Improvement",
   "topic": "Summarizes rollout governance, acceptance criteria, after-action review practices, data stewardship, and procedures for improving the system after each fire season."
  }
 ],
