{
 "title": "Operational Concept for the Greenvale Metro Communications-Based Train Control System",
 "sections": [
  {
   "index": 1,
   "heading": "Operational Context and Control Philosophy",
   "topic": "Defines the Greenvale Metro operating environment, service objectives, control-room responsibilities, and the high-level communications-based train control philosophy for normal and degraded operation."
  },
  {
   "index": 2,
   "heading": "Onboard CBTC Functions and Train Interfaces",
   "topic": "Describes the onboard controller, odometry, train radio, operator interfaces, brake assurance functions, and the expected interaction with trainborne subsystems."
  },
  {
   "index": 3,
   "heading": "Wayside Communications and Zone Supervision",
   "topic": "Explains the radio access network, safety data network, zone controller boundaries, handover behavior, and wayside supervision principles."
  },
  {
   "index": 4,
   "heading": "Interlocking Integration and Route Protection",
   "topic": "Covers the interface between CBTC supervision and junction interlockings, including route setting, point locking, axle counter indications, and platform approach protection."
  },
  {
   "index": 5,
   "heading": "Operations Control Centre Workflows",
   "topic": "Details the workflows used by traffic controllers for service regulation, temporary restrictions, incident management, timetable updates, and authority review."
  },
  {
   "index": 6,
   "heading": "Station, Platform, and Passenger-Facing Interfaces",
   "topic": "Specifies how platform screen doors, station status indications, passenger information gateways, and dispatch-related controls exchange operational data with the CBTC system."
  },
  {
   "index": 7,
   "heading": "Diagnostics, Maintenance, and Asset Monitoring",
   "topic": "Describes event collection, remote diagnostics, maintenance roles, failure triage, configuration records, and evidence retained for post-incident analysis."
  },
  {
   "index": 8,
   "heading": "Degraded Modes and Manual Recovery",
   "topic": "Explains fallback operating modes, manual route recovery, restricted manual movements, reset authorizations, and the responsibilities of operators and maintainers during disruption."
  },
  {
   "index": 9,
   "heading": "Cybersecurity, Key Management, and Audit Obligations",
   "topic": "Defines cybersecurity monitoring, certificate lifecycle controls, audit evidence, access governance, and security responsibilities for safety-related communications."
  },
  {
   "index": 10,
   "heading": "Commissioning, Migration, and Readiness for Revenue Service",
   "topic": "Outlines test-train operation, staged migration from legacy signalling, readiness reviews, operational rehearsal, and acceptance criteria for revenue service."
  }
 ],
